  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Ribbon.xml" LogicalName="InkMath.AddIn.Ribbon.xml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InkMath.Tests" />
  </ItemGroup>
</Project>
